# --- Base de données ---
# Production : chaîne de connexion PostgreSQL Supabase
#   (Supabase > Project Settings > Database > Connection string > "Session pooler")
# DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# Développement local : SQLite (aucune installation nécessaire)
DATABASE_URL=file:./ouragan.db

# Chaîne aléatoire longue (ex. : openssl rand -hex 32)
PAYLOAD_SECRET=CHANGE_MOI

# URL publique du site
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Images (Supabase Storage, compatible S3) — laisser vide en local ---
# Supabase > Storage > S3 Connection (créer un bucket public "media" et une clé d'accès)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
